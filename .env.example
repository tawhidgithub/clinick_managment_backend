# Copy to .env and fill in real values.
NODE_ENV=development
PORT=4000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/chowa_clinic?schema=public

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# lax when frontend and API share a site (localhost, app.x.com + api.x.com)
# none when they are on different sites (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

APP_TIMEZONE=Asia/Dhaka

# Background jobs (expire memberships, close past queues). Set false on all but
# one instance if the API ever runs as several processes.
RUN_JOBS=true

# Reverse proxies in front of the API (Nginx = 1). Default: 1 in production, 0 otherwise.
# TRUST_PROXY=1

# Requests per minute per IP across the whole API (0 = off). The clinic's
# computers usually share one public IP, so keep this generous.
RATE_LIMIT_PER_MINUTE=1200

# Database for `npm test` (emptied on every run; the name must end in _test).
# Default: DATABASE_URL with _test added to the database name.
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/chowa_clinic_test?schema=public

# Public base URL of this API, used in signed links to uploaded files.
# Defaults to http://localhost:PORT
# PUBLIC_API_URL=https://api.example.com

# local = files on this server's disk (back up UPLOAD_DIR with the database)
# r2    = Cloudflare R2 (needs the R2_* values below)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
FILE_URL_TTL_SECONDS=3600
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Used only by prisma/seed.ts for the first admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe@123
